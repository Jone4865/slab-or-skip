{
  "name": "slab-or-skip",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite --port 5290 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5291 --strictPort",
    "test": "vitest run src/domain",
    "calibrate": "vitest run src/dev",
    "typecheck": "tsc -b --noEmit",
    "deploy": "GH_PAGES=1 npm run build && node scripts/deploy-pages.mjs"
  },
  "dependencies": {
    "firebase": "13.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "6.0.7",
    "vitest": "2.1.8"
  }
}
